---
// Layout base: <html lang="pt-BR">, metadados Open Graph, fonte de títulos pré-carregada, tema pelo sistema.
// A classe no-js some no primeiro script; sem JavaScript, o CSS mostra tudo e esconde só os controles.
import '../styles/global.css';
import '../styles/components.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Endereço canônico, quando a página repete outra (ex.: /categoria/… → /). */
  canonical?: string;
  noindex?: boolean;
}

const { title, description = site.descricao, canonical, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.nome}` : `${site.nome} · ${site.papel}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.nomeCompleto} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1117" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="João Marcos: dados públicos coletados automaticamente e conferidos com a fonte oficial" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="pf-btn pf-btn--secondary sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50" href="#conteudo">Pular para o conteúdo</a>
    <slot name="nav" />
    <main id="conteudo" tabindex="-1" class="outline-none">
      <slot />
    </main>
  </body>
</html>

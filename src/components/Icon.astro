---
// Ícones de linha do Design System (grade 24 px, traço 1,75, currentColor). Sempre decorativos:
// quando o ícone é o único conteúdo de um botão, o aria-label vai no botão.
const paths = {
  seta: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  download: '<path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7"/>',
  codigo: '<path d="M8 8l-4 4 4 4"/><path d="M16 8l4 4-4 4"/><path d="M13.5 5l-3 14"/>',
  envelope: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  fechar: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  externo: '<path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  copiar: '<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/>',
  pausar: '<path d="M9 6v12"/><path d="M15 6v12"/>',
  tocar: '<path d="M8 5.5v13l10.5-6.5z"/>',
  mao: '<path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V11"/><path d="M12 10V4.5a1.5 1.5 0 0 1 3 0V11"/><path d="M15 10.5V6.5a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L3.6 13.6a1.5 1.5 0 0 1 2.4-1.8L9 15"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: 'sm' | 'md';
  class?: string;
  style?: string;
}

const { name, size = 'md', class: className, style } = Astro.props;
---
<svg class:list={['pf-icon', size === 'sm' && 'pf-icon--sm', className]} style={style} viewBox="0 0 24 24" aria-hidden="true" set:html={paths[name]} />

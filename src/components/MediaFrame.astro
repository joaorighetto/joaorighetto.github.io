---
// MediaFrame: moldura 16:10, fundo accent-soft, a peça sobre bg-raised com borda line.
// SVG entra inline (as cores seguem o tema); imagem raster passa pelo astro:assets.
// Sem arquivo, mostra um esquema de linha do tipo (sem números, nomes ou dados), até a imagem real chegar.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kind: 'map' | 'diagram' | 'table' | 'capture';
  src?: string;
  alt: string;
  class?: string;
  style?: string;
  /** Carregamento imediato (topo da página de projeto). */
  eager?: boolean;
}

const { kind, src, alt, class: className, style, eager = false } = Astro.props;

const svgs = import.meta.glob<{ default: (props: Record<string, unknown>) => unknown }>('/src/assets/projetos/**/*.svg', { eager: true });
const rasters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projetos/**/*.{png,jpg,jpeg,webp}', { eager: true });

const path = src ? `/src/assets/projetos/${src}` : undefined;
const Svg = path ? svgs[path]?.default : undefined;
const raster = path ? rasters[path]?.default : undefined;
if (path && !Svg && !raster) throw new Error(`MediaFrame: arquivo não encontrado: ${path}`);

const pieceClass = 'pf-media__piece';
---
<div class:list={['pf-media', kind === 'map' && 'pf-media--map', kind === 'diagram' && 'pf-media--diagram', className]} style={style}>
  {Svg && <Svg class={pieceClass} role="img" aria-label={alt} />}
  {raster && <Image class={pieceClass} src={raster} alt={alt} widths={[400, 800, 1200]} sizes="(min-width: 1024px) 360px, (min-width: 720px) 50vw, 100vw" loading={eager ? 'eager' : 'lazy'} />}
  {!path && (
    <svg class={`${pieceClass} pf-media__esquema`} viewBox="0 0 320 200" preserveAspectRatio="xMidYMid meet" role="img" aria-label={alt}>
      {kind === 'map' && (
        <g>
          <path d="M70 46 L150 34 L232 50 L262 104 L236 160 L150 170 L84 152 L56 98 Z" />
          <path d="M150 34 L160 100 L236 160 M160 100 L56 98 M160 100 L84 152" />
          <path d="M196 86c0-10 8-18 18-18s18 8 18 18c0 14-18 30-18 30s-18-16-18-30z" />
          <circle cx="214" cy="86" r="5" />
        </g>
      )}
      {kind === 'capture' && (
        <g>
          <rect x="40" y="30" width="240" height="140" rx="6" />
          <path d="M40 50h240 M96 50v120" />
          <path d="M52 66h32 M52 80h28 M52 94h32" />
          <path d="M112 68h80 M112 90h152 M112 110h152 M112 130h152 M112 150h152" />
        </g>
      )}
      {kind === 'table' && (
        <g>
          <rect x="40" y="36" width="240" height="128" rx="6" />
          <path d="M40 60h240 M40 86h240 M40 112h240 M40 138h240 M120 36v128 M200 36v128" />
        </g>
      )}
      {kind === 'diagram' && (
        <g>
          <rect x="30" y="80" width="70" height="40" rx="4" />
          <path d="M100 100h30 M124 94l6 6-6 6" />
          <rect x="130" y="80" width="70" height="40" rx="4" />
          <path d="M200 100h30 M224 94l6 6-6 6" />
          <rect x="230" y="80" width="60" height="40" rx="4" />
        </g>
      )}
    </svg>
  )}
</div>

<style>
  /* Esquema de espera: traço accent de 1,5 px sem preenchimento, como as figuras do ProcessSteps. */
  .pf-media__esquema { color: var(--accent); }
  .pf-media__esquema :global(g) { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
</style>
